# ---- Database ----
# Point this at your PostgreSQL instance. If you use the bundled docker-compose,
# the default below works out of the box.
DATABASE_URL=postgresql://eauction:eauction@localhost:5432/eauction

# ---- API server ----
PORT=4000
# Comma-separated list of allowed CORS origins (the Vite frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API in-memory cache TTL (milliseconds). Set 0 to disable.
API_CACHE_TTL_LIST_MS=60000
API_CACHE_TTL_DETAIL_MS=120000
API_CACHE_TTL_META_MS=300000

# ---- BAANKNET data source (baanknet.com JSON API) ----
# Data is fetched from baanknet's public JSON API (the same endpoints its
# Angular frontend uses). Effective API base:
#   BAANKNET_ORIGIN + BAANKNET_CONTEXT_PATH + BAANKNET_API_CONTEXT_PATH
BAANKNET_ORIGIN=https://baanknet.com
BAANKNET_CONTEXT_PATH=/eauction-psb
BAANKNET_API_CONTEXT_PATH=/api
BAANKNET_LANG_ID=1
BAANKNET_IMAGE_BASE_URL=https://d14q55p4nerl4m.cloudfront.net

# Politeness / throttling
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
SCRAPER_CONCURRENCY=4
SCRAPER_DELAY_MS=300
SCRAPER_REQUEST_TIMEOUT_MS=30000
SCRAPER_MAX_RETRIES=3

# How much to ingest from the full property catalog. Property type ids:
# 1 Residential, 2 Commercial, 3 Agricultural, 4 Industrial, 5 Other.
# MAX_PAGES_PER_TYPE caps pagination per type (0 = no cap = the full catalog).
# FETCH_DETAILS=true also fetches each property's full detail + image gallery.
BAANKNET_PROPERTY_TYPES=1,2,3,4,5
BAANKNET_PAGE_SIZE=50
BAANKNET_MAX_PAGES_PER_TYPE=3
BAANKNET_FETCH_DETAILS=true
BAANKNET_SKIP_EXISTING=false
# Price-band sharding: auto (recommended) | on | off
# BAANKNET caps each listing query at ~10k results; auto splits by price when needed.
BAANKNET_PRICE_SHARD=auto
BAANKNET_LISTING_CAP=10000

# Set true only if behind a TLS-intercepting proxy and you cannot run Node with
# --use-system-ca (Node 22+). Disables TLS certificate verification.
BAANKNET_INSECURE_TLS=false

# ---- bankeauctions.com data source (C1 India) ----
# Server-rendered site: listings from a DataTables JSON endpoint, details from
# HTML pages (parsed with cheerio). No headless browser required.
BANKEAUCTIONS_ORIGIN=https://www.bankeauctions.com
BANKEAUCTIONS_PAGE_SIZE=10
BANKEAUCTIONS_MAX_RECORDS=0
BANKEAUCTIONS_FETCH_DETAILS=true
BANKEAUCTIONS_SKIP_EXISTING=false
BANKEAUCTIONS_CONCURRENCY=3
BANKEAUCTIONS_INSECURE_TLS=false

# ---- Multi-source runner / scheduler ----
SOURCE_BAANKNET_ENABLED=true
SOURCE_BANKEAUCTIONS_ENABLED=true

# ---- Object storage for sale-notice PDFs (Cloudflare R2 / S3-compatible) ----
# Leave blank to skip mirroring (the download endpoint proxies the bank URL).
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MIRROR_IMAGES=false

# ---- Weekly refresh scheduler (npm run schedule) ----
CRON_SCHEDULE=0 3 * * 0
CRON_TIMEZONE=Asia/Kolkata
CRON_RUN_ON_START=false
